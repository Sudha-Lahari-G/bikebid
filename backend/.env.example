# Copy to backend/.env for running the API outside Docker. Never commit the real .env.
# In docker compose these are set in docker-compose.yml; in production, in the Render dashboard.

ENVIRONMENT=local                      # local | test | production
DATABASE_URL=postgresql+psycopg://bike_user:local_dev_password_change_me@localhost:5433/bike_auction
TEST_DATABASE_URL=postgresql+psycopg://bike_user:local_dev_password_change_me@localhost:5433/bike_auction_test
REDIS_URL=redis://localhost:6380/0     # optional — leave empty for in-memory realtime + rate limits

JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=120
CORS_ORIGINS=http://localhost:5173     # comma-separated

LOG_LEVEL=INFO
LOG_JSON=false                         # true in production for log aggregators

# Bootstrap admin (created on startup if missing)
ADMIN_EMAIL=admin@bikebid.dev
ADMIN_PASSWORD=change-me-please

# Demo mode: re-lists bikes and runs bot bidders so the public demo is always lively
DEMO_MODE=false
DEMO_USER_EMAIL=demo@bikebid.dev
DEMO_USER_PASSWORD=

# Bidding rules
ANTI_SNIPE_WINDOW_SECONDS=120
ANTI_SNIPE_EXTENSION_SECONDS=120
RATE_LIMIT_BIDS_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10

# If set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
