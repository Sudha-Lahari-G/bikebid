# Copy to .env.local for local development, or set these in the Vercel dashboard.

# Where the FastAPI backend lives (no trailing slash). WebSockets use the same host.
VITE_API_URL=http://localhost:8000

# Optional: shows a "Try the demo bidder account" button on the sign-in page.
# Must match DEMO_USER_EMAIL / DEMO_USER_PASSWORD on the backend.
VITE_DEMO_EMAIL=demo@bikebid.dev
VITE_DEMO_PASSWORD=BikeBid@123
